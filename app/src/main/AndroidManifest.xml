<?xml version="1.0" encoding="utf-8"?>
<!--
  Resonance manifest — Phase 1 foundation.
  Privacy: NO INTERNET permission by design. Local-first, offline-first.
  Playback service + notification channels land in Phase 2; permissions below
  are declared now so the manifest does not need restructuring later.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13+ granular audio permission. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <!-- Pre-13 fallback; never requested on API 33+. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Phase 2 foreground playback service. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- Phase 2 playback notification (API 33+ only). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".app.ResonanceApp"
        android:label="@string/app_name"
        android:theme="@style/Theme.Resonance"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
